<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Archetypes</RootNamespace>
    <AssemblyName>Archetypes.Core</AssemblyName>
    <Version>0.1.0</Version>
    <PackageId>Archetypes.Core</PackageId>
    <Authors>RossSim</Authors>
    <Description>Preset catalogs and builder for Personality Engine mind seeds.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RossSim/archetypes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RossSim/archetypes.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PersonalityEngine.Core" Version="0.6.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\presets\**\*.json">
      <LogicalName>archetypes.preset.%(Filename).json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
